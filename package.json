{
  "name": "overline-zebar",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "prettier": "^3.0.0",
    "syncpack": "14.0.0-alpha.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  },
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm --filter \"@overline-zebar/*\" build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,html,yaml,vue,svelte,graphql}",
    "check-format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,html,yaml,vue,svelte,graphql}\"",
    "lint": "eslint . && pnpm --filter \"./widgets/*\" run lint",
    "lint:fix": "eslint . --fix && pnpm --filter \"./widgets/*\" run lint:fix"
  },
  "dependencies": {
    "react-compiler-runtime": "catalog:",
    "use-debounce": "^10.0.5"
  }
}
